{
  "profile": "vue-nuxt",
  "description": "Dynamic capability routing for Vue/Nuxt agents by file type and task shape.",
  "modes": [
    {
      "name": "page",
      "file_globs": ["pages/**/*.vue"],
      "owned_by": ["vue-coder", "vue-reviewer", "vue-tester"],
      "suggested_skills": ["new-page", "design-implement", "implement-feature", "add-tests"],
      "focus": [
        "SSR and hydration safety",
        "useAsyncData or useFetch strategy",
        "SEO and route-level UX states"
      ]
    },
    {
      "name": "component",
      "file_globs": ["components/**/*.vue"],
      "owned_by": ["vue-coder", "vue-reviewer", "vue-tester"],
      "suggested_skills": ["new-component", "design-implement", "implement-feature", "add-tests"],
      "focus": [
        "typed props, emits, slots",
        "minimal template logic",
        "reusable component API"
      ]
    },
    {
      "name": "layout",
      "file_globs": ["layouts/**/*.vue"],
      "owned_by": ["vue-coder", "vue-reviewer", "vue-tester"],

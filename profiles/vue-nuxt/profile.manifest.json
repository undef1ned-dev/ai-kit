{
  "profile": "vue-nuxt",
  "label": "Vue Nuxt",
  "role": "web",
  "stack": "Vue 3, Nuxt 3, Pinia, VueUse",
  "agents": {
    "architect": "vue-architect",
    "coder": "vue-coder",
    "tester": "vue-tester",
    "reviewer": "vue-reviewer"
  },
  "specialists": {
    "design-bridge": {
      "agent": "vue-design-bridge",
      "when": "задача идёт от макета Figma или нужна сверка с UI kit и дизайн-токенами"
    }
  },
  "commands": {
    "lint": "npx eslint {files}",
    "format": "npx prettier --write {files}",
    "test": "npx vitest run",
    "build": "npx nuxt build",
    "run": "npx nuxt dev"
  },
  "code_extensions": [".vue", ".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"],
  "root_markers": ["nuxt.config.ts", "nuxt.config.js", "nuxt.config.mjs"],
  "path_signals": ["pages/", "components/", "composables/", "stores/", "server/api/", "middleware/", "plugins/", "layouts/", "app.vue", "nuxt.config.", "vitest.config.", "playwright.config.", "eslint.config."]
}

{
  "profile": "python-fastapi",
  "label": "Python FastAPI",
  "role": "backend",
  "stack": "FastAPI 0.115+, SQLAlchemy 2.0, LangGraph",
  "agents": {
    "architect": "fastapi-architect",
    "coder": "fastapi-coder",
    "tester": "fastapi-tester",
    "reviewer": "fastapi-reviewer"
  },
  "specialists": {
    "langgraph-expert": {
      "agent": "fastapi-langgraph-expert",
      "when": "в ARCHITECT_PLAN указано AGENT_NEEDED: да — фича строится на LangGraph"
    }
  },
  "commands": {
    "install": "uv sync",
    "lint": "uv run ruff check {files}",
    "format": "uv run ruff format {files}",
    "test": "uv run pytest",
    "run": "uv run uvicorn main:app --reload"
  },
  "code_extensions": [".py"],
  "root_markers": ["main.py", "app/main.py"],
  "path_signals": ["routers/", "schemas/", "models/", "migrations/", "tests/", "main.py"]
}

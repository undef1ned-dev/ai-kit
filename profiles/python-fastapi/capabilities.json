{
  "profile": "python-fastapi",
  "description": "Dynamic capability routing for FastAPI agents by backend layer and artifact type.",
  "modes": [
    {
      "name": "router-schema",
      "file_globs": ["routers/**/*.py", "schemas/**/*.py", "main.py"],
      "owned_by": ["fastapi-coder", "fastapi-reviewer", "fastapi-tester"],
      "suggested_skills": ["new-router", "implement-feature"],
      "focus": [
        "endpoint contracts and response models",
        "request validation",
        "router registration"
      ]
    },
    {
      "name": "service-model",
      "file_globs": ["services/**/*.py", "models/**/*.py", "core/database.py", "core/jwt.py"],
      "owned_by": ["fastapi-coder", "fastapi-reviewer", "fastapi-tester"],
      "suggested_skills": ["implement-feature", "add-migration"],
      "focus": [
        "service-layer business logic",
        "SQLAlchemy 2.0 patterns",
        "auth and persistence boundaries"
      ]
    },
    {
      "name": "migration-test",
      "file_globs": ["migrations/**/*.py", "alembic/**/*.py", "tests/**/*.py"],
      "owned_by": ["fastapi-coder", "fastapi-reviewer", "fastapi-tester"],
      "suggested_skills": ["add-migration", "implement-feature"],
      "focus": [
        "migration safety",
        "test isolation",
        "coverage of API and service flows"
      ]
    }
  ]
}

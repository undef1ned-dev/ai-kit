{
  "profile": "python-django",
  "label": "Python Django",
  "role": "backend",
  "stack": "Django 5.x, DRF, Django Admin",
  "agents": {
    "architect": "django-architect",
    "coder": "django-coder",
    "tester": "django-tester",
    "reviewer": "django-reviewer"
  },
  "specialists": {
    "admin-expert": {
      "agent": "django-admin-expert",
      "when": "задача про Django Admin: ModelAdmin, инлайны, фильтры, actions, права операторов"
    }
  },
  "commands": {
    "lint": "uv run ruff check {files}",
    "format": "uv run ruff format {files}",
    "test": "uv run pytest",
    "run": "uv run python manage.py runserver"
  },
  "code_extensions": [".py"],
  "root_markers": ["manage.py"],
  "path_signals": ["apps/", "config/", "manage.py"]
}
